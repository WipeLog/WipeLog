<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:Class="Wipelog.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Wipelog.App/Theme/Tokens/Colors.axaml" />
        <ResourceInclude Source="avares://Wipelog.App/Theme/Tokens/Typography.axaml" />
        <ResourceInclude Source="avares://Wipelog.App/Theme/Tokens/Spacing.axaml" />
        <ResourceInclude Source="avares://Wipelog.App/Theme/Tokens/RailIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- SukiUI is the base theme (replaces FluentTheme). It ships its own
         DataGrid styling, so no separate DataGrid theme include is needed.
         Our Theme/Styles/Theme.axaml runs after it for app-specific tweaks. -->
    <suki:SukiTheme ThemeColor="Blue" />
    <StyleInclude Source="avares://Wipelog.App/Theme/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
