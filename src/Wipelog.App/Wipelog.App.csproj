<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Wipelog.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Tmds.DBus.Protocol vuln (GHSA-xrw6-gwf8-vvr9) is pulled in transitively
         by Avalonia.Desktop on Linux. Avalonia hasn't shipped a fix as of
         11.3.6; the parser bug doesn't apply to our outbound-only DBus use. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wipelog.Core\Wipelog.Core.csproj" />
    <ProjectReference Include="..\Wipelog.Library\Wipelog.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Icons/*.png" />
    <AvaloniaResource Include="Assets/Icons/Specs/*.jpg" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wipelog.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.15" />
    <!-- DataGrid releases slower than the main Avalonia line; 11.3.13 is the
         newest 11.x. It's compatible with Avalonia 11.3.15. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.15" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.15" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.15" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LibVLCSharp" Version="3.9.0" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.9.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="SukiUI" Version="6.1.1" />
  </ItemGroup>
</Project>
