<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wipelog.App.ViewModels"
             xmlns:svc="using:Wipelog.App.Services"
             xmlns:controls="using:Wipelog.App.Controls"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:Class="Wipelog.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource SukiBackground}">

  <UserControl.Resources>
    <!-- Material-style 24-viewBox geometries for the tab icons (RailIcons.axaml
         only covers the content categories). -->
    <StreamGeometry x:Key="IconGear">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
    <StreamGeometry x:Key="IconBolt">M7,2V13H10V22L17,10H13L17,2H7Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Settings tab rail entry. Mirrors SideNav's nav-entry visually but
         driven by a Command + Classes.active binding rather than a
         ToggleButton group, since these tabs are view-state, not data-state. -->
    <Style Selector="Button.tab-entry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="Margin" Value="12,2" />
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
    </Style>
    <Style Selector="Button.tab-entry /template/ ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.13" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Active state mirrors the main SukiSideMenu rail: the same SukiUI
         selection treatment — a subtle accent-tint pill with accent-coloured
         text — so the two sidebars read as the same app. Background must sit
         on the Button itself (not the templated ContentPresenter) to span the
         full rail width; the inner ContentPresenter only carries text styling. -->
    <Style Selector="Button.tab-entry:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor5}" />
    </Style>
    <Style Selector="Button.tab-entry.active">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor10}" />
    </Style>
    <Style Selector="Button.tab-entry.active /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource SukiPrimaryColor120}" />
      <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.tab-entry.active:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor10}" />
    </Style>

    <!-- Keep help-icon (and other) tooltip text readable instead of stretching
         across the window. HelpIcon styles its own colors in code. -->
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="320" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="48,Auto,*"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
    <!-- Header bar with back button. No bottom separator — matches the main view. -->
    <Border Grid.Row="0"
            Background="Transparent"
            BorderThickness="0">
      <Grid ColumnDefinitions="Auto,*" Margin="12,0">
        <Button Name="BackButton"
                Grid.Column="0"
                Background="Transparent" BorderThickness="0"
                Padding="8,4"
                Click="OnBackClick"
                ToolTip.Tip="Back to clip browser"
                AutomationProperties.Name="Back">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="←" FontSize="18" VerticalAlignment="Center" />
            <TextBlock Text="Back" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1"
                   Text="Settings"
                   FontWeight="SemiBold"
                   FontSize="{StaticResource FontSizeTitleBar}"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0" />
      </Grid>
    </Border>

    <!-- Onboarding banner. Hidden once LogDirectory is set; reappears if
         the user blanks the field. Clicking Detect runs WowLogDetector
         against well-known Linux WoW launcher prefixes; clicking a
         candidate chip applies it as the daemon's combat-log directory
         and jumps to the Service tab for the install step. -->
    <Border Grid.Row="1"
            IsVisible="{Binding IsOnboardingNeeded}"
            Background="{DynamicResource WarningBackgroundBrush}"
            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,2"
            Padding="20,12">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="!" FontSize="16" FontWeight="Bold"
                     Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                     Width="14" TextAlignment="Center" />
          <TextBlock Text="Welcome to Wipelog - finish setting it up to start recording."
                     FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="Wipelog needs to know where WoW writes its combat logs. Click Detect to scan Lutris / Heroic / Bottles / Faugus / Wine prefixes, or set the path manually in the Storage tab." />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="accent"
                  Command="{Binding DetectWowLogsCommand}"
                  IsEnabled="{Binding !IsDetectingWowLogs}"
                  FontWeight="SemiBold"
                  Content="Detect WoW logs"
                  AutomationProperties.Name="Detect WoW combat logs" />
          <TextBlock Text="{Binding DetectionMessage}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" VerticalAlignment="Center"
                     IsVisible="{Binding DetectionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <!-- Candidate chips. One per detected directory; click to apply. -->
        <ItemsControl ItemsSource="{Binding DetectedLogPaths}"
                      IsVisible="{Binding HasDetectedLogPaths}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="svc:DetectedLogPath">
              <Button HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Margin="0,3,0,0"
                      Padding="10,6"
                      Background="{DynamicResource BackgroundElevatedBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1" CornerRadius="4"
                      Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ApplyDetectedPathCommand}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="Apply this WoW logs path">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Path}" FontFamily="monospace"
                             FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="{Binding LogFileCount}" />
                    <Run Text=" log file(s)" />
                  </TextBlock>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Body: left rail + content -->
    <Grid Grid.Row="2" ColumnDefinitions="200,*">

      <!-- Tab rail. No right separator — matches the main SukiSideMenu rail. -->
      <Border Grid.Column="0"
              Background="Transparent"
              BorderThickness="0">
        <StackPanel Margin="0,16,0,0" Spacing="5">
          <Button Classes="tab-entry"
                  Classes.active="{Binding IsGeneralTab}"
                  Command="{Binding SelectTabCommand}" CommandParameter="General"
                  AutomationProperties.Name="General settings">
            <StackPanel Orientation="Horizontal" Spacing="15">
              <Path Width="22" Height="22" Stretch="Uniform" Data="{StaticResource IconGear}"
                    Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
              <TextBlock Text="General" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tab-entry"
                  Classes.active="{Binding IsRecordingTab}"
                  Command="{Binding SelectTabCommand}" CommandParameter="Recording"
                  AutomationProperties.Name="Recording settings">
            <StackPanel Orientation="Horizontal" Spacing="15">
              <Path Width="22" Height="22" Stretch="None" Data="M11,4 A7,7 0 1,1 10.99,4 Z"
                    Fill="{DynamicResource DangerBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Text="Recording" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tab-entry"
                  Classes.active="{Binding IsStorageTab}"
                  Command="{Binding SelectTabCommand}" CommandParameter="Storage"
                  AutomationProperties.Name="Storage settings">
            <StackPanel Orientation="Horizontal" Spacing="15">
              <Path Width="22" Height="22" Stretch="Uniform" Data="{StaticResource IconFolder}"
                    Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
              <TextBlock Text="Storage" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tab-entry"
                  Classes.active="{Binding IsServiceTab}"
                  Command="{Binding SelectTabCommand}" CommandParameter="Service"
                  AutomationProperties.Name="Service settings">
            <StackPanel Orientation="Horizontal" Spacing="15">
              <Path Width="22" Height="22" Stretch="Uniform" Data="{StaticResource IconBolt}"
                    Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
              <TextBlock Text="Service" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Content area: each tab is a ScrollViewer gated by IsXxxTab -->
      <Grid Grid.Column="1">

        <!-- Each tab insets its card with Margin rather than ScrollViewer.Padding:
             Avalonia measures scroll content without the padding, so wrapped
             text would be laid out wider than it is drawn (see ClipDetailsView). -->

        <!-- ─── GENERAL ─── -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding IsGeneralTab}">
          <suki:GlassCard MaxWidth="780" HorizontalAlignment="Left" Margin="24,24,24,80" Padding="24">
            <StackPanel Spacing="22">

            <StackPanel Spacing="8">
              <TextBlock Classes="title" Text="NOTIFICATIONS" />
              <CheckBox Content="Show notification when clip is saved"
                        IsChecked="{Binding NotifyOnClipSaved, Mode=TwoWay}" />
              <CheckBox Content="Show notification on errors"
                        IsChecked="{Binding NotifyOnErrors, Mode=TwoWay}" />
              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                         Text="The daemon reads these from ~/.config/wipelog/preferences.json at startup. Reinstall the service to apply." />
            </StackPanel>

            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

            <StackPanel Spacing="8">
              <TextBlock Classes="title" Text="WINDOW" />
              <CheckBox Content="Hide to tray when closing the window"
                        IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
            </StackPanel>

            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

            <StackPanel Spacing="8">
              <TextBlock Classes="title" Text="TIMELINE" />
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                    ColumnSpacing="{StaticResource Space12}" RowSpacing="{StaticResource Space6}">
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock VerticalAlignment="Center" Text="Seek-back on marker click (seconds)" />
                  <controls:HelpIcon Tip="When you click a death marker, the player seeks this many seconds before the death so you see the lead-up." />
                </StackPanel>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Width="100"
                               Minimum="{Binding TimelineSeekBackMin}"
                               Maximum="{Binding TimelineSeekBackMax}"
                               Increment="1" FormatString="0"
                               Value="{Binding TimelineSeekBackSeconds, Mode=TwoWay}" />
                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="Pause when clicking a timeline marker"
                          IsChecked="{Binding TimelinePauseOnClick, Mode=TwoWay}" />
              </Grid>
            </StackPanel>

          </StackPanel>
          </suki:GlassCard>
        </ScrollViewer>

        <!-- ─── RECORDING ─── -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding IsRecordingTab}">
          <suki:GlassCard MaxWidth="780" HorizontalAlignment="Left" Margin="24,24,24,80" Padding="24">
            <StackPanel Spacing="22">

            <StackPanel Spacing="10">
              <TextBlock Classes="title" Text="CONTENT" />
              <StackPanel Spacing="12">

                <!-- Raids -->
                <StackPanel Spacing="6">
                  <CheckBox Content="Record Raids"
                            IsChecked="{Binding RecordRaids, Mode=TwoWay}" />
                  <StackPanel Margin="24,0,0,0" Spacing="{StaticResource Space4}"
                              IsVisible="{Binding RecordRaids}">
                    <TextBlock Classes="muted" Text="Difficulties" />
                    <controls:ChipSelector SelectedItems="{Binding SelectedRaidDifficulties}"
                                           AvailableItems="{Binding AvailableRaidDifficulties}" />
                  </StackPanel>
                </StackPanel>

                <!-- Mythic+ -->
                <StackPanel Spacing="6">
                  <CheckBox Content="Record Mythic+"
                            IsChecked="{Binding RecordMythicPlus, Mode=TwoWay}" />
                  <StackPanel Margin="24,0,0,0" Orientation="Horizontal"
                              Spacing="{StaticResource Space8}"
                              IsVisible="{Binding RecordMythicPlus}">
                    <TextBlock Classes="muted" Text="Minimum keystone level"
                               VerticalAlignment="Center" />
                    <NumericUpDown Width="120"
                                   Minimum="{Binding MinKeystoneLevelMin}"
                                   Maximum="{Binding MinKeystoneLevelMax}"
                                   Increment="1" FormatString="0"
                                   Value="{Binding MinKeystoneLevel, Mode=TwoWay}" />
                  </StackPanel>
                </StackPanel>

                <!-- Battlegrounds -->
                <StackPanel Spacing="6">
                  <CheckBox Content="Record Battlegrounds"
                            IsChecked="{Binding RecordBattlegrounds, Mode=TwoWay}" />
                </StackPanel>

              </StackPanel>
              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                         TextWrapping="Wrap"
                         Text="Saved automatically and applied to the running daemon within a second — no restart needed. Clearing every difficulty chip records all difficulties." />
            </StackPanel>

            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

            <StackPanel Spacing="10">
              <TextBlock Classes="title" Text="VIDEO" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="{StaticResource Space4}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="muted" Text="Video quality" VerticalAlignment="Center" />
                    <controls:HelpIcon Tip="medium ≈ 8 Mbps at 1080p60; high ≈ 16 Mbps; ultra ≈ 25 Mbps — affects file size and bitrate." />
                  </StackPanel>
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding VideoQualityChoices}"
                            SelectedItem="{Binding VideoQuality, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="{StaticResource Space4}">
                  <TextBlock Classes="muted" Text="Framerate" />
                  <NumericUpDown Minimum="24" Maximum="240" Increment="1" FormatString="0"
                                 HorizontalAlignment="Stretch"
                                 Value="{Binding Framerate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="{StaticResource Space4}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="muted" Text="Codec" VerticalAlignment="Center" />
                    <controls:HelpIcon Tip="h264 is most compatible; h265 is smaller files but slower decode; av1 is smallest but newest." />
                  </StackPanel>
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding CodecChoices}"
                            SelectedItem="{Binding Codec, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource Space4}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="muted" Text="Container" VerticalAlignment="Center" />
                    <controls:HelpIcon Tip="mp4 is universal; mkv handles unexpected stops better." />
                  </StackPanel>
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ContainerChoices}"
                            SelectedItem="{Binding Container, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="{StaticResource Space4}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="muted" Text="Resolution" VerticalAlignment="Center" />
                    <controls:HelpIcon Tip="`source` records at your monitor's native resolution. The 720p / 1080p / 1440p choices downscale during encode to save disk space; width is derived from your monitor's aspect ratio so ultrawides stay un-letterboxed." />
                  </StackPanel>
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding VideoResolutionChoices}"
                            SelectedItem="{Binding VideoResolution, Mode=TwoWay}" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

            <StackPanel Spacing="10">
              <TextBlock Classes="title" Text="CAPTURE" />
              <StackPanel Spacing="{StaticResource Space4}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="muted" Text="Capture target" VerticalAlignment="Center" />
                  <controls:HelpIcon Tip="focused records whatever window is active — switches as you alt-tab. DisplayPort-0 etc. records that specific monitor regardless of focus." />
                </StackPanel>
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding CaptureTargetChoices}"
                          SelectedItem="{Binding CaptureTarget, Mode=TwoWay}" />
                <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                           Text="`focused` follows the active window — pick a monitor (e.g. DisplayPort-0) to keep recording while you alt-tab." />
              </StackPanel>

              <StackPanel Spacing="{StaticResource Space4}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="muted" Text="gpu-screen-recorder executable" VerticalAlignment="Center" />
                  <controls:HelpIcon Tip="Only change if you've installed gpu-screen-recorder to a non-standard path." />
                </StackPanel>
                <TextBox Text="{Binding GpuScreenRecorderExecutable, Mode=TwoWay}" />
              </StackPanel>
            </StackPanel>

            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

            <StackPanel Spacing="10">
              <TextBlock Classes="title" Text="AUDIO TRACKS" />
              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                         TextWrapping="Wrap"
                         Text="Each row becomes a separate audio track in the recording. Use `app:NAME` for per-application audio (Spotify, Discord, World of Warcraft), `default_output` for the full system mix, `default_input` for the microphone, or `app-inverse:A|B|C` for everything except those apps." />

              <ItemsControl ItemsSource="{Binding AudioTracks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:AudioTrackEntry">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="{StaticResource Space8}"
                          Margin="0,0,0,6">
                      <TextBlock Grid.Column="0"
                                 Width="140"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding DerivedLabel}"
                                 Text="{Binding DerivedLabel}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Source, Mode=TwoWay}"
                               Watermark="e.g. app:spotify" />
                      <Button Grid.Column="2"
                              Content="×"
                              FontSize="14"
                              Padding="10,4"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveAudioTrackCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Remove this track" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                <Button Content="+ Add track"
                        Command="{Binding AddAudioTrackCommand}"
                        CommandParameter="default_output" />
                <controls:HelpIcon Tip="`app:WoW` records only that app's audio. `default_output` records everything. `default_input` records your microphone. Mix and match." />
                <Button Content="Add running app…">
                  <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding AudioSourceSuggestions}">
                      <MenuFlyout.ItemTemplate>
                        <DataTemplate DataType="vm:AudioSourceSuggestion">
                          <MenuItem Header="{Binding Display}"
                                    CommandParameter="{Binding Source}"
                                    Click="OnAudioSuggestionClick" />
                        </DataTemplate>
                      </MenuFlyout.ItemTemplate>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <Button Content="Refresh"
                        Command="{Binding RefreshAudioSuggestionsCommand}"
                        ToolTip.Tip="Re-query gpu-screen-recorder --list-application-audio" />
                <Button Content="Apply 4-track preset"
                        Command="{Binding ApplyAudioPresetCommand}"
                        ToolTip.Tip="Replaces the list with Game / Spotify / Discord / Everything-else." />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                         Text="Reinstall the systemd service after changing tracks for the live recorder to pick them up. The test-recording button below uses the current list directly." />
            </StackPanel>

            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

            <StackPanel Spacing="10">
              <TextBlock Classes="title" Text="PRE-ENCOUNTER BUFFER" />
              <CheckBox Content="Prepend pre-encounter seconds to each clip"
                        IsChecked="{Binding PreRollEnabled, Mode=TwoWay}" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}"
                          IsEnabled="{Binding PreRollEnabled}">
                <TextBlock Classes="muted" Text="Buffer seconds" VerticalAlignment="Center" />
                <controls:HelpIcon Tip="Higher buffer = more RAM. 30 s at 1080p medium ≈ 100–200 MB." />
                <NumericUpDown Width="120"
                               Minimum="{Binding PreRollSecondsMin}"
                               Maximum="{Binding PreRollSecondsMax}"
                               Increment="1" FormatString="0 s"
                               Value="{Binding PreRollSeconds, Mode=TwoWay}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                         TextWrapping="Wrap"
                         Text="Runs a second gpu-screen-recorder in replay-buffer mode so each clip starts a few seconds before the pull (pre-pots, opener GCDs, mark calls). Requires ffmpeg + ffprobe on PATH. RAM cost scales with seconds x resolution x quality - 30 s at 1080p medium is typically 100-200 MB. Reinstall the service after changing." />
            </StackPanel>

            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

            <StackPanel Spacing="10">
              <TextBlock Classes="title" Text="POST-ENCOUNTER TAIL" />
              <CheckBox Content="Keep recording for a few seconds after the encounter ends"
                        IsChecked="{Binding PostRollEnabled, Mode=TwoWay}" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}"
                          IsEnabled="{Binding PostRollEnabled}">
                <TextBlock Classes="muted" Text="Tail seconds" VerticalAlignment="Center" />
                <NumericUpDown Width="120"
                               Minimum="{Binding PostRollSecondsMin}"
                               Maximum="{Binding PostRollSecondsMax}"
                               Increment="1" FormatString="0 s"
                               Value="{Binding PostRollSeconds, Mode=TwoWay}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                         TextWrapping="Wrap"
                         Text="Holds the recorder open for a few seconds after each kill / wipe / dungeon completion so the saved video captures the immediate aftermath (kill cam, key chest opening, wipe panic). Does not affect the manual Stop button. Reinstall the service after changing." />
            </StackPanel>

            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

            <StackPanel Spacing="10">
              <TextBlock Classes="title" Text="CHAT OVERLAY" />
              <CheckBox Content="Mask chat region in recordings"
                        IsChecked="{Binding ChatOverlayEnabled, Mode=TwoWay}" />
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" RowDefinitions="Auto,Auto"
                    ColumnSpacing="{StaticResource Space8}" RowSpacing="8"
                    IsEnabled="{Binding ChatOverlayEnabled}">
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <TextBlock Classes="muted" Text="X" VerticalAlignment="Center" />
                  <controls:HelpIcon Tip="Position in pixels from the left edge of your screen." />
                </StackPanel>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Width="120"
                               Minimum="{Binding ChatOverlayPosMin}" Maximum="{Binding ChatOverlayMax}"
                               Increment="1" FormatString="0"
                               Value="{Binding ChatOverlayX, Mode=TwoWay}" />
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock Classes="muted" Text="Y" VerticalAlignment="Center" />
                  <controls:HelpIcon Tip="Distance in pixels up from the bottom edge of your screen to the bottom of the box. 0 sits the box flush with the bottom, where WoW's chat lives." />
                </StackPanel>
                <NumericUpDown Grid.Row="0" Grid.Column="4" Width="120"
                               Minimum="{Binding ChatOverlayPosMin}" Maximum="{Binding ChatOverlayMax}"
                               Increment="1" FormatString="0"
                               Value="{Binding ChatOverlayY, Mode=TwoWay}" />
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <TextBlock Classes="muted" Text="Width" VerticalAlignment="Center" />
                  <controls:HelpIcon Tip="Size of the masked region in pixels." />
                </StackPanel>
                <NumericUpDown Grid.Row="1" Grid.Column="1" Width="120"
                               Minimum="{Binding ChatOverlaySizeMin}" Maximum="{Binding ChatOverlayMax}"
                               Increment="1" FormatString="0"
                               Value="{Binding ChatOverlayWidth, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Classes="muted" Text="Height"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <NumericUpDown Grid.Row="1" Grid.Column="4" Width="120"
                               Minimum="{Binding ChatOverlaySizeMin}" Maximum="{Binding ChatOverlayMax}"
                               Increment="1" FormatString="0"
                               Value="{Binding ChatOverlayHeight, Mode=TwoWay}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}"
                          IsEnabled="{Binding ChatOverlayEnabled}">
                <Button Content="Test mask" Command="{Binding TestMaskCommand}" />
                <controls:HelpIcon Tip="Snapshots the monitor selected in Capture target, paints the configured rectangle on it, and opens the result so you can dial in the X/Y/W/H values." />
              </StackPanel>
              <SelectableTextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                                   Text="{Binding TestMaskMessage}"
                                   IsVisible="{Binding TestMaskMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap" />
              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                         TextWrapping="Wrap"
                         Text="When enabled, a solid black rectangle is composited over this region of every recording, applied as an ffmpeg post-processing step (the clip is re-encoded on the GPU). Useful for hiding chat, whispers, and member names from clips you share. Changes apply after reinstalling the systemd service (Service tab)." />
            </StackPanel>

            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

            <StackPanel Spacing="10">
              <TextBlock Classes="title" Text="TEST RECORDING" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                <NumericUpDown Width="120"
                               Minimum="{Binding TestRecordingSecondsMin}"
                               Maximum="{Binding TestRecordingSecondsMax}"
                               Increment="1" FormatString="0 s"
                               Value="{Binding TestRecordingSeconds, Mode=TwoWay}"
                               IsEnabled="{Binding !IsTestRecording}" />
                <Button Classes="accent"
                        Content="Run test recording"
                        Command="{Binding RunTestRecordingCommand}"
                        IsVisible="{Binding !IsTestRecording}" />
                <Button Content="Cancel"
                        Command="{Binding CancelTestRecordingCommand}"
                        IsVisible="{Binding IsTestRecording}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                         Text="Captures a short clip using the current settings to verify capture target, audio, codec, and output directory. The file lands in the output directory and is invisible to the library (no sidecar)." />
              <SelectableTextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                                   Text="{Binding TestRecordingMessage}"
                                   IsVisible="{Binding TestRecordingMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap" />
            </StackPanel>

          </StackPanel>
          </suki:GlassCard>
        </ScrollViewer>

        <!-- ─── STORAGE ─── -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding IsStorageTab}">
          <suki:GlassCard MaxWidth="780" HorizontalAlignment="Left" Margin="24,24,24,80" Padding="24">
            <StackPanel Spacing="22">

            <StackPanel Spacing="10">
              <TextBlock Classes="title" Text="STORAGE MANAGEMENT" />

              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Classes="muted" Text="Keep free (GB)" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Width="120"
                               Minimum="{Binding MinFreeGigabytesMin}"
                               Maximum="{Binding MinFreeGigabytesMax}"
                               Increment="5" FormatString="0"
                               Value="{Binding MinFreeGigabytes, Mode=TwoWay}" />
              </Grid>

              <StackPanel Spacing="{StaticResource Space4}">
                <TextBlock Classes="muted" Text="Disk usage" />
                <ProgressBar Minimum="0" Maximum="100" Height="10"
                             Value="{Binding DaemonStatus.DiskUsagePercent}"
                             Foreground="{Binding DaemonStatus.DiskUsageBarBrush}" />
                <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                           Text="{Binding DaemonStatus.DiskUsageText}" />
              </StackPanel>

              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}" TextWrapping="Wrap"
                         Text="Wipelog keeps at least this much free space on the drive that holds your clips: when free space drops toward this floor it deletes the oldest non-favorited clips to recover it. Favorited clips are never deleted automatically. You can't set this higher than the drive's size. Changes apply on the next service reinstall/restart." />
            </StackPanel>

            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

            <StackPanel Spacing="10">
              <TextBlock Classes="title" Text="PATHS" />

              <StackPanel Spacing="{StaticResource Space4}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="muted" Text="Daemon binary path" VerticalAlignment="Center" />
                  <controls:HelpIcon Tip="Run `dotnet publish src/Wipelog.Daemon -c Release --no-self-contained -o ~/bin/wipelog` to populate this." />
                </StackPanel>
                <TextBox Text="{Binding DaemonExecutablePath, Mode=TwoWay}" />
                <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                           Text="Full path to Wipelog.Daemon. Run `dotnet publish src/Wipelog.Daemon -c Release --no-self-contained -o ~/bin/wipelog` to populate the default location." />
              </StackPanel>

              <StackPanel Spacing="{StaticResource Space4}">
                <TextBlock Classes="muted" Text="Combat-log directory" />
                <TextBox Text="{Binding LogDirectory, Mode=TwoWay}"
                         Watermark="e.g. ~/.wine/drive_c/Program Files (x86)/World of Warcraft/_retail_/Logs" />
              </StackPanel>

              <StackPanel Spacing="{StaticResource Space4}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="muted" Text="Combat-log file pattern" VerticalAlignment="Center" />
                  <controls:HelpIcon Tip="WoW writes log files named `WoWCombatLog-YYYYMMDD_HHMMSS.txt`. The default pattern `WoWCombatLog-*.txt` matches all of them." />
                </StackPanel>
                <TextBox Text="{Binding LogPattern, Mode=TwoWay}" />
              </StackPanel>

              <StackPanel Spacing="{StaticResource Space4}">
                <TextBlock Classes="muted" Text="Output directory (clips)" />
                <TextBox Text="{Binding OutputDirectory, Mode=TwoWay}" />
                <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                           Text="The GUI also reads from this directory. Change requires a daemon reinstall to take effect; restart the GUI to refresh the watcher." />
              </StackPanel>

              <StackPanel Spacing="{StaticResource Space4}">
                <TextBlock Classes="muted" Text="Database path" />
                <TextBox Text="{Binding DaemonDatabasePath, Mode=TwoWay}" />
              </StackPanel>
            </StackPanel>

            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

            <StackPanel Spacing="8">
              <TextBlock Classes="title" Text="LIBRARY" />
              <Button Classes="accent" Content="Re-index library"
                      HorizontalAlignment="Left"
                      Command="{Binding ReindexCommand}"
                      IsEnabled="{Binding !IsWorking}" />
              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}" Text="{Binding StatusMessage}" />
            </StackPanel>

          </StackPanel>
          </suki:GlassCard>
        </ScrollViewer>

        <!-- ─── SERVICE ─── -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding IsServiceTab}">
          <suki:GlassCard MaxWidth="780" HorizontalAlignment="Left" Margin="24,24,24,80" Padding="24">
            <StackPanel Spacing="22">

            <StackPanel Spacing="10">
              <TextBlock Classes="title" Text="SYSTEMD SERVICE" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space8}">
                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                        DataContext="{Binding DaemonStatus}"
                        Background="{Binding DotBrush}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           DataContext="{Binding DaemonStatus}"
                           Text="{Binding Tooltip}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </Grid>
              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                         Text="Unit file path:" />
              <SelectableTextBlock Text="{Binding ServiceFilePath}" FontFamily="monospace" />

              <!-- Shown when a daemon-arg setting (quality, audio, framerate,
                   codec, pre-roll, paths) changed since the service was last
                   installed. Recording filters never land here — they hot-reload. -->
              <Border IsVisible="{Binding HasPendingUnitChanges}"
                      Background="#3d29a55a"
                      BorderBrush="#d29922" BorderThickness="0,0,0,2"
                      CornerRadius="4" Padding="14,10">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="!" FontSize="16" FontWeight="Bold"
                               Foreground="#d29922" VerticalAlignment="Center"
                               Width="14" TextAlignment="Center" />
                    <TextBlock Text="Settings changed since the service was installed."
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock FontSize="12"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Text="Video, audio, and other daemon options take effect only after the service is reinstalled (this restarts the recorder)." />
                  <Button Classes="accent" Content="Reinstall now to apply"
                          HorizontalAlignment="Left"
                          Command="{Binding ReinstallServiceCommand}"
                          IsEnabled="{Binding !IsServiceWorking}" />
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                <Button Classes="accent" Content="Install service"
                        Command="{Binding InstallServiceCommand}"
                        IsVisible="{Binding IsNotInstalled}"
                        IsEnabled="{Binding !IsServiceWorking}" />
                <Button Classes="accent" Content="Reinstall with current settings"
                        Command="{Binding ReinstallServiceCommand}"
                        IsVisible="{Binding ShowReinstallButton}"
                        IsEnabled="{Binding !IsServiceWorking}" />
                <Button Content="Uninstall"
                        Command="{Binding UninstallServiceCommand}"
                        IsVisible="{Binding IsInstalled}"
                        IsEnabled="{Binding !IsServiceWorking}" />
                <Button Content="Refresh state"
                        Command="{Binding RefreshServiceStateCommand}"
                        IsEnabled="{Binding !IsServiceWorking}" />
                <Button Content="Open systemd journal"
                        Command="{Binding ViewDaemonLogsCommand}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="{StaticResource FontSizeMeta}"
                         Text="{Binding ServiceMessage}" />
            </StackPanel>

          </StackPanel>
          </suki:GlassCard>
        </ScrollViewer>

      </Grid>
    </Grid>
  </Grid>
</UserControl>
